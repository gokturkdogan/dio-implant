DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
ADMIN_JWT_SECRET="replace-with-long-random-secret"
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="change-me"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_FOLDER="dio-implant/admin"

# Parola sıfırlama e-postası (SMTP)
APP_BASE_URL="http://localhost:3000"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="DIO Implant <noreply@example.com>"
# Gönderen görünen ad: DIO Implant | adres: noreply@... (Gmail'de genelde SMTP_USER ile aynı domain gerekir)
# SMTP_SECURE="true"
